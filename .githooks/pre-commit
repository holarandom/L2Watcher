#!/bin/sh
# Блокирует коммит, если в него попал приватный модуль.
#
# .gitignore защищает только от случайного попадания. Он НЕ спасает от
# `git add -f`, от неаккуратной правки самого .gitignore и от файла,
# который уже был проиндексирован раньше. Этот хук смотрит на то, что
# РЕАЛЬНО уходит в коммит, и останавливает его.
#
# Установка (один раз):  git config core.hooksPath .githooks

# CLAUDE.md тоже в списке: он описывает закрытый модуль exp/ прямым текстом,
# а репозиторий публичный. Опубликовать его — то же самое, что опубликовать
# сам модуль, только словами.
BLOCKED='(^|/)exp/|(^|/)exp_module\.zip$|(^|/)exp_config\.json$|(^|/)exp_state\.json$|(^|/)exp_templates/|(^|/)CLAUDE\.md$'

staged=$(git diff --cached --name-only --diff-filter=ACMR)

hits=$(printf '%s\n' "$staged" | grep -E "$BLOCKED")

if [ -n "$hits" ]; then
    echo ""
    echo "=============================================================="
    echo "  КОММИТ ОСТАНОВЛЕН: приватный модуль попал в индекс"
    echo "=============================================================="
    echo ""
    echo "  Эти файлы нельзя коммитить в публичный репозиторий:"
    echo ""
    printf '%s\n' "$hits" | sed 's/^/    /'
    echo ""
    echo "  Убрать из коммита (файлы на диске останутся):"
    echo ""
    printf '%s\n' "$hits" | sed 's/^/    git restore --staged /'
    echo ""
    echo "=============================================================="
    echo ""
    exit 1
fi

# Вторая проверка: не ослабили ли сам .gitignore.
# Если .gitignore меняется, а строки exp/ в нём больше нет — стоп.
if printf '%s\n' "$staged" | grep -qx '.gitignore'; then
    if ! git show :.gitignore | grep -qx 'exp/'; then
        echo ""
        echo "=============================================================="
        echo "  КОММИТ ОСТАНОВЛЕН: из .gitignore пропала строка 'exp/'"
        echo "=============================================================="
        echo ""
        echo "  Верни её на место — без неё приватный модуль перестанет"
        echo "  быть закрытым при следующем 'git add .'"
        echo ""
        exit 1
    fi
fi

exit 0
